# Your domain, for example music.example.com. It must point at this machine.
MUSIC_DOMAIN=

# Clients must send this key ("Authorization: Bearer <key>"). Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
XZ_MUSIC_API_KEY=

# Optional: free client id from https://devportal.jamendo.com to enable Jamendo.
JAMENDO_CLIENT_ID=

# Optional: folder with your own music files.
MUSIC_DIR=./music
